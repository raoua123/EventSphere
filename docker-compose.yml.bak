version: '3.8'

services:
  php:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: symfony_php
    environment:
      - APP_ENV=dev
      - APP_DEBUG=1
      - JWT_PASSPHRASE=${JWT_PASSPHRASE:-change_me}
      - APP_DOMAIN=${APP_DOMAIN:-localhost}
      - DATABASE_URL=postgresql://user:${DB_PASSWORD:-raoua}@db:5432/event_reservation?serverVersion=15&charset=utf8
      - WEBAUTHN_RP_NAME=${WEBAUTHN_RP_NAME:-Event Reservation App}
    volumes:
      - .:/var/www
      - ./config/jwt:/var/www/config/jwt
    depends_on:
      db:
        condition: service_healthy
    networks:
      - app_network

  nginx:
    image: nginx:alpine
    container_name: symfony_nginx
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./public:/var/www/public:ro
      - ./docker/nginx/conf.d:/etc/nginx/conf.d
      - ./docker/ssl:/etc/nginx/ssl:ro
    depends_on:
      - php
    networks:
      - app_network

  db:
    image: postgres:15-alpine
    container_name: symfony_db
    environment:
      - POSTGRES_DB=event_reservation
      - POSTGRES_USER=user
      - POSTGRES_PASSWORD=${DB_PASSWORD:-raoua}
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U user -d event_reservation"]
      interval: 5s
      timeout: 5s
      retries: 5
    networks:
      - app_network
    ports:
      - "5432:5432"

networks:
  app_network:
    driver: bridge

volumes:
  postgres_data: